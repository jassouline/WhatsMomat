# ============================================================================
# WhatsMomat v1.2 — Configuration d'environnement (Exemple sans secret réel)
# Copiez ce fichier vers `.env` ou injectez ces variables via Secret Manager.
# ============================================================================

# Port et interface d'écoute (127.0.0.1 par défaut ; définir 0.0.0.0 uniquement dans un conteneur isolé)
PORT=3000
HOST=127.0.0.1

# Nom du fichier SQLite persistant stocké dans ./data/ (ou ":memory:" pour un mode éphémère/test)
DB_PATH=whatsmomat.sqlite

# Mode d'authentification :
# - "demo" : sélecteur de personas actif pour tester les ACLs (Engineering, SecOps, RH, Executive)
# - "iap"  : mode production Zero-Trust lisant X-Goog-Authenticated-User-Email / X-Forwarded-User
AUTH_MODE=demo

# Secret de signature HMAC des cookies de session (>= 32 caractères aléatoires, obligatoire en NODE_ENV=production)
# Générer avec : openssl rand -hex 32
SESSION_SECRET=

# Intégration Gemini en direct via @google/genai (Interactions API + Embeddings hybrides RRF)
# Si vide, WhatsMomat bascule automatiquement sur son moteur RAG et vectoriel local hors-ligne.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Jeton Machine-to-Machine (>= 24 caractères) pour pousser des documents/tickets/OneBox via POST /api/v1/ingest
# Générer avec : openssl rand -hex 24
INGEST_API_TOKEN=

# Jeton SCIM 2.0 (>= 24 caractères) pour synchroniser/désactiver les comptes Okta / Entra ID / Workday via /api/v1/scim/v2/Users
# Générer avec : openssl rand -hex 24
SCIM_API_TOKEN=

# Liste blanche optionnelle d'hôtes autorisés pour les appels OneBox sortants & Webhooks d'approbation (séparés par des virgules)
OUTBOUND_ALLOWED_HOSTS=

# Mode de résolution des raccourcis /go/<alias> :
# - "auto" (défaut) : vraie redirection HTTP 302 pour les vraies URLs externes, modale Moma pour *.corp.internal
# - "302"           : force une redirection HTTP 302 externe systématique sur tous les liens go/
GO_REDIRECT_MODE=auto

# Liste d'origines CORS additionnelles autorisées (séparées par des virgules, jamais "*")
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
